# Use a unique project name for each deployment on the same host.
COMPOSE_PROJECT_NAME=studydy-competition-eng
STUDYDY_PORT=4177
STUDYDY_PUBLIC_ORIGIN=http://127.0.0.1:4177
STUDYDY_SECURE_COOKIE=false
# Paths are relative to the repository; tests must use independent data.
STUDYDY_DATA_DIR=./.studydy-product/compose
STUDYDY_UID=1000
STUDYDY_GID=1000

POSTGRES_DB=studydy_competition_eng
POSTGRES_USER=studydy
# Required secret password, passed to containers only at runtime.
POSTGRES_PASSWORD=

# Model origin only: no /v1 path, credentials, query, or fragment.
STUDYDY_SEMANTIC_BASE_URL=http://host.docker.internal:18000
VLLM_API_KEY=

# SSH: enable the ssh profile and use http://model-bridge:18000 as the model origin.
# The bridge reads the API key remotely; SSH credentials are mounted read-only.
# Empty file paths use defaults under STUDYDY_DATA_DIR/ssh/.
COMPOSE_PROFILES=
STUDYDY_SSH_HOST=
STUDYDY_SSH_PORT=22
STUDYDY_SSH_MODEL_PORT=18000
STUDYDY_SSH_KEY_FILE=
STUDYDY_SSH_KNOWN_HOSTS_FILE=
